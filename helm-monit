# Helm, dacă nu e instalat pe acest nod:
curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-4
chmod 700 get_helm.sh && ./get_helm.sh

RAW=https://raw.githubusercontent.com/georgestresna/shortener/main/infra/platform/monitoring

helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo add grafana-community https://grafana-community.github.io/helm-charts
helm repo update

helm install prometheus prometheus-community/prometheus \
  -n monitoring --create-namespace -f $RAW/prometheus-values.yaml

helm install grafana grafana-community/grafana \
  -n monitoring -f $RAW/grafana-values.yaml

kubectl get pods -n monitoring -w